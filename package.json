{
  "name": "stereogramer-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm --filter @stereogramer/web dev",
    "build": "pnpm --filter \"./packages/*\" build",
    "test": "pnpm --filter @stereogramer/core test && pnpm --filter @stereogramer/cli test",
    "typecheck": "tsc -b packages/core packages/cli packages/web"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
